<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageTags>mudbase;mudbase-sdk;mudbase-api;mudbase.dev;api;sdk;api-client;rest;client;baas;backend-as-a-service;auth;database;storage;realtime;serverless;csharp;dotnet</PackageTags>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo><!-- setting GenerateAssemblyInfo to false causes this bug https://github.com/dotnet/project-system/issues/3934 -->
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Mudbase.SDK</AssemblyName>
    <PackageId>Mudbase.SDK</PackageId>
    <OutputType>Library</OutputType>
    <Authors>Mudbase</Authors>
    <Company>Mudbase</Company>
    <AssemblyTitle>Mudbase SDK</AssemblyTitle>
    <Description>The official C# client for the Mudbase API.</Description>
    <Copyright>Copyright (c) 2026 Mudbase. All rights reserved.</Copyright>
    <RootNamespace>Mudbase.SDK</RootNamespace>
    <Version>1.3.18</Version>
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\Mudbase.SDK.xml</DocumentationFile>
    <PackageProjectUrl>https://docs.mudbase.dev</PackageProjectUrl>
    <RepositoryUrl>https://github.com/themudhaxk/mudbase-sdk-csharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>Corrected the package metadata: authors, company, assembly title, description and copyright now identify Mudbase, and the package now links to the Mudbase documentation. No API or behaviour changes.</PackageReleaseNotes>
    <Nullable>annotations</Nullable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JsonSubTypes" Version="2.0.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Polly" Version="8.1.0" />
  </ItemGroup>

  <ItemGroup>
  </ItemGroup>
  <ItemGroup>
  </ItemGroup>
</Project>
